def text(txt,x,y,font=F,col=WHITE,center=False):
    a=font.render(str(txt),True,col);r=a.get_rect()
    if center:r.center=(x,y)
    else:r.topleft=(x,y)
    screen.blit(a,r);return r
def wrap(txt,font,width):
    out=[];line=""
    for word in txt.split():
        test=(line+" "+word).strip()
        if font.size(test)[0]<=width:line=test
        else:
            if line:out.append(line)
            if font.size(word)[0]<=width:line=word
            else:
                piece=""
                for char in word:
                    if piece and font.size(piece+char)[0]>width:
                        out.append(piece);piece=char
                    else:piece+=char
                line=piece
    if line:out.append(line)
    return out
def para(txt,x,y,width,font=F,col=WHITE,gap=6,limit=None):
    lines=wrap(txt,font,width)
    if limit:lines=lines[:limit]
    for ln in lines:text(ln,x,y,font,col);y+=font.get_linesize()+gap
